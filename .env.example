# Anavibe MCP A2A Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env files with real secrets

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=anavibe
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# SERVER SETTINGS
# =============================================================================
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# JWT Settings
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Key Settings (for agent authentication)
API_KEY_HEADER=X-API-Key

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
# PostgreSQL Connection
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/anavibe
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# =============================================================================
# REDIS SETTINGS (for caching and rate limiting)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_SSL=false

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# MCP A2A SETTINGS
# =============================================================================
# Agent Registration
AGENT_REGISTRATION_ENABLED=true
AGENT_HEARTBEAT_INTERVAL_SECONDS=30
AGENT_TIMEOUT_SECONDS=120

# Message Queue Settings
MESSAGE_QUEUE_MAX_SIZE=1000
MESSAGE_RETENTION_HOURS=24

# Encryption for agent-to-agent communication
A2A_ENCRYPTION_ENABLED=true
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
A2A_ENCRYPTION_KEY=your-fernet-key-here

# =============================================================================
# OBSERVABILITY
# =============================================================================
# Logging
LOG_FORMAT=json
LOG_FILE=logs/anavibe.log

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# Tracing
TRACING_ENABLED=false
TRACING_ENDPOINT=http://localhost:4317

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Anthropic API (if integrating with Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI API (if needed)
OPENAI_API_KEY=your-openai-api-key
